# Copy this file to .env.local and fill in your own values.
# Never commit .env.local. It holds real secrets.

# ---------- Supabase ----------
# Project Settings → Data API (URL) and Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Server only. Bypasses row-level security, so never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ---------- Email (Resend) ----------
RESEND_API_KEY=re_xxxxxxxxxxxx

# Use onboarding@resend.dev until your domain is verified in Resend.
# In test mode, Resend can only send to the email on your Resend account.
EMAIL_FROM="Show Up SOKY <onboarding@resend.dev>"

# Where new-submission alerts and "update your group" requests go.
CONTACT_EMAIL=you@example.com

# ---------- Site ----------
# http://localhost:3000 locally; your live URL in production (no trailing slash).
SITE_URL=http://localhost:3000

# ---------- Weekly digest ----------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-string